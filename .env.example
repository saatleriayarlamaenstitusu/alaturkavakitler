# Bu dosya örnektir ve git'e girer; gerçek değerler .env'de durur ve
# .env git'e GİRMEZ. Depo herkese açık.
#
# VITE_ önekli olanlar derleme anında pakete yazılır — yani tarayıcıya
# ulaşır. Gizli olması gereken hiçbir şey VITE_ ile başlamamalı.

VITE_VAKIT_BASE_URL=https://raw.githubusercontent.com/saatleriayarlamaenstitusu/data-diyanet-namaz-vakitleri/main/data/namaz/
VITE_GA_ID=

# Açık Kuran API anahtarı. VITE_ öneki YOK ve olmamalı: yalnızca Cloudflare
# Pages Function'ı (functions/api/kuran/) ve geliştirme vekili okur, pakete
# hiç girmez. Üretimde Cloudflare panosunda tanımlanır:
#   Settings → Environment variables → ACIKKURAN_KEY
ACIKKURAN_KEY=
